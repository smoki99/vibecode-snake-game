# Dependencies and generated caches — never authored, never committed.
node_modules/
.npm/
.cache/
.piweb/

# Build scratch: esbuild intermediates, Playwright resolver cache, rendered previews.
.build/

# Secrets. The preview tunnel and GitHub pushes read tokens from the environment; a .env file here is
# convenience only and must never reach the public remote.
.env
.env.*
!.env.example

# Local agent/tooling state, not project source.
.claude/
.pi/
.app.log
.tunnel.log
.build-pw-*.log
*.log

# The generated rasters and the single-file bundle under dist/ ARE deliverables and stay tracked:
# they are what you hand to a browser, a favicon requester or a link unfurler.
